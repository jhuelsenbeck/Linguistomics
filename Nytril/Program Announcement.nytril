using Format, LinkTypes;

//======================================================================

readonly DocReference ProgramAnnouncementReference = new(#53db497e-a3bc-4d83-81e7-91c91dd026cc#, Article) {
  Title: "TongueTwister Program Announcement";
  AuthorLink to [People.Huelsenbeck_John, People.Goldstein_David, People.McCreight_Shawn];
};

//======================================================================

class ProgramAnnouncementContent: AuthoredContent {
  Constructor {
    super.Constructor("Program Announcement", ProgramAnnouncementReference);
    Description = "Description of the TongueTwister program";
    SetCorrespondant(People.Goldstein_David);
    Title = "TongueTwister: Analysis of cognate word forms in a Bayesian framework";
    Abstract = new ProgramAnnouncementAbstractSection;

    AddContent(new ProgramAnnouncementIntroductionSection);
  }
}

//======================================================================

class ProgramAnnouncementAbstractSection: Content {
  Constructor {
    super.Constructor("Abstract");
  }

    override GetBody(ContentStyle style) = Block {
    style.Par {
      TextHeight: 12pt;
      SpaceBefore: 18pt;
      SpaceAfter: 12pt;
      "TongueTwister is a software package for examining the evolution of cognates as sequences of phonemic states under an event-based model of insertion, deletion, and substitution. ";
      "Parameters are estimated in a Bayesian framework with Markov chain Monte Carlo (MCMC) used to numerically approximate posterior probability distributions for parameters. ";
      "Unlike traditional cognate-based phylogenetic analyses that rely on fixed morphological codings or treat gaps as missing data, TongueTwister implements the TKF91 model, allowing alignments to be treated as latent variables and marginalized over using MCMC. ";
      "This approach accommodates alignment uncertainty while pooling information across sites to estimate substitution dynamics. ";
      "TongueTwister supports a range of substitution models, from a simple equal-rates model to the highly parameterized general time-reversible model, and provides tools for both posterior inference and marginal likelihood estimation via stepping-stone sampling. ";
      "The program is intended as a research tool for exploring sequence-based models of language evolution and for evaluating competing evolutionary hypotheses within a coherent probabilistic framework.";
    };
  };
}

//======================================================================

class ProgramAnnouncementIntroductionSection: Content {
  Constructor {
    super.Constructor("Introduction");
  }

  override GetBody(ContentStyle style) = Block {
    style.Par {
      "Like biological species, languages evolve through descent with modification, as words change within communities and communities split into diverging traditions of speech. ";
      "The pattern of language divergence, and specifically, the order of divergences among languages, can be described by a tree-like diagram called a phylogeny. ";
      "Interestingly, linguists began constructing language trees at about the same time that biologists began reconstructing the Tree of Life. ";
      "More recently, linguists have taken advantage of tools developed in the evolutionary biology community to estimate trees using Bayesian inference. ";
      "In particular, they have adopted the morphological stochastic models implemented in software such as MrBayes and BEAST. ";
      "(Morphological models describe the evolution of anatomical characteristics of organisms.) ";
      "Cognate-words that share a common ancestral origin, akin to homologous structures in biology, are coded by the linguist into discrete states (0, 1, 2, ...). ";
      "The coded cognate data are then analyzed by the software using Bayesian statistical methods. ";
      "The output is a probability distribution of evolutionary trees conditioned on the cognate coding scheme, often accompanied by posterior distributions for the other parameters of the phylogenetic model. ";
    };

     style.Par {
      "Next paragraph. ";
      
    };
  };


}

//======================================================================
