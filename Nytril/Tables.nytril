using Format;

//======================================================================

readonly namespace DisplayWords {
  HeaderCell(d) = Cell(new(new(0, 2pt), new(0, 2pt), new(0, 2pt), new(1, 2pt))) {
    PaperStyle.TitleBackground;
    d
  };

  ShowLanguage(ContentStyle style, ExperimentData data, Taxon taxon) = Block {
    PaperStyle.TitleBar {taxon.Language};
    Table(0.5, null, [new(Column.Fit(2.1"), null, PadLR(10)), new(Column.Fit(1.5"), null, PadR(10)), Column.Expand]) {
      style.SansSerif;
      Row {
        HeaderCell(Lang.Cognate);
        HeaderCell(Lang.IPA);
        HeaderCell(Lang.Segments);
      };

      var i = 0;
      foreach (var cognate in data.GetSortedCognates) {
        foreach (var word in cognate.Words[taxon.Index]) {
          if (word.Segments is valid) {
            PaperStyle.RowBar(i++) {
              word.Cognate.GetTitle;
              word.ShowPlain;
              Span {
                (each word.Segments).ShowBlock;
              }
            };
          }
        }
      }
    };
    Paragraph;
  };

  ShowWordsByLanguage(ContentStyle style, ExperimentData data) = Block {
    ShowLanguage(style, data, each data.Taxa);
  };
}

//======================================================================

readonly namespace AllWords {
  AddCell(Taxon taxon, Cognate cognate, textheight) = Cell {
    Background: each0 mod 2 == 0 ? 97% : null;
    cognate.Words[taxon.Index].ShowPaddedBlocks(textheight);
  };

  AddRow(ContentStyle style, Taxon taxon, Cognate[] cognates, textheight) = Row {
    Cell(PadL(1pt)) {
      style.SansSerif;
      TextColor: Colors.DarkGray;
      taxon.Language;
    };
    AddCell(taxon, each cognates, textheight)
  };

  ConceptTable(ContentStyle style, ExperimentData data, textheight, wordsperline, Cognate[] cognates) = HBox {
    var first = 84pt;
    var w     = (ExtentWidth - first) / wordsperline;
    Table(0.5, null, [first] + [w] * wordsperline) {
      PaperStyle.IPAFamily;
      Row {
        PaperStyle.TitleBackground;
        style.SansSerif;
        Empty;
        (each cognates).GetTitle;
      };

      AddRow(style, each data.Taxa, cognates, textheight);
    };
    Paragraph;
  };

  ShowConceptTable(ContentStyle style, ExperimentData data, Cognate cognate) = ConceptTable(style, data, 10pt, 7, [cognate]);

  ShowTable(ContentStyle style, ExperimentData data, textheight, int max=1000000) = Block {
    TextHeight: textheight;
    var wordsperline = (ExtentWidth / (14 * (textheight toscale Units.pixels))) as int;

    foreach (var cognates in (data.GetSortedCognates / wordsperline)) {
      if (each0 >= max)
        break;
      ConceptTable(style, data, textheight, wordsperline, cognates);
    }
  };
}

readonly namespace MatchCell {
  SegmentText(SegmentSet set, SegmentPart segment) {
    if (not segment.Segment.Impossible) {
      set.Add(segment);
      return segment.ShowSegment;
    }
    return null;
  }

  SegmentBox(SegmentSet set, SegmentPart segment, color) = Canvas(PaperStyle.BoxSize.Width, PaperStyle.BoxSize.Height) {
    HAlign: Center;
    if (segment.?Ipa is valid) {
      TextHeight: PaperStyle.BoxSize.Height - 6pt;
      TextColor: color;
      SegmentText(set, segment)
    }
    else
      PaperStyle.ImpossibleBackground;
  };

  ShowBox(SegmentSet set, SegmentPart segment, color) = SegmentBox(set, segment, color) {
    if (segment.Features.HasFlag(Voiced))
      X: PaperStyle.BoxSize.Width;
  };

  ErrorMatches(SegmentSet set, SegmentPart[] matches) = Span {
    Separator: CommaSpace;
    TextColor: Colors.Red;
    MatchCell.SegmentText(set, each matches);
  };
}

//======================================================================

class SegmentDisplay {
  var ExperimentData Data;
  var SegmentPart[]  SortedSegments,
                     DisplaySegments;

  Constructor(ExperimentData data) {
    Data            = data;
    DisplaySegments = data.UniqueSegments;  // Could be IPA.Segments if you want to see all possible segments in the debug tables
    SortedSegments  = data.UniqueSegments.ToSortedArray(true, @CompareAlpha);
  }

  static int CompareSegments(SegmentPart s0, SegmentPart s1) = s0.UsedCount - s1.UsedCount;

  static int CompareAlpha(SegmentPart s0, SegmentPart s1) {
    var i = s0.Ipa.Length.Compare(s1.Ipa.Length);
    if (i == 0)
      i = -s0.Ipa.Compare(s1.Ipa);
    return i;
  }

  FrequencyChart(ContentStyle style, Size size) = Chart(size.Width, size.Height) {
    TextHeight: 11pt;
    style.SansSerif;
    ChartType: ChartTypes.Column;
    Legend: ChartLegend {Placement: Placements.Bottom};
    ValueLabel: PaperStyle.ValueLabel {
      Lang.FrequencyPercent;
    };

    SegmentPart[] sorted = DisplaySegments.ToSortedArray(true, @CompareSegments);
    XAxis: ChartAxis {
      TextHeight: PaperStyle.SegmentTextFactor * size.Width / sorted.Length;
      (each sorted).ShowSegment;
    };
    ValueAxis: ChartAxis;
    ChartSeries {
      TextDigits: 3;
      Label: Lang.Experiment;
      foreach (var s in sorted)
        new DataPoint(each0, s.UsedFrequency * 100.0) {Reference: s};
    };
  };

  VocalSegmentTable = Block {
    var c = PaperStyle.SegmentColumns;

    Table(null, null, [ExtentWidth / c]) {
      foreach (var segments in (SortedSegments / c)) {
        Row {
          foreach (var s in segments) {
            Cell(new Edge(0.25pt, 2pt, Colors.LightGray)) {
              s.Segment.Display(16pt);
            };
          }
        }
      }
    };
    PaperStyle.TableNotes;
  };

  ShowLanguageDetails(ContentStyle style) = Block {
    foreach (var taxon in Data.Taxa) {
      var language = taxon.Language;
      Paragraph {
        SpaceAfter: 10pt;
        HBox(100%, null, BorderT(1pt) + PadT(16pt)) {
          VAlign: Center;
          Frame(40%) {
            style.HeadingPar(0) {
              language.Name;
            };
            Block {
              ParAlignment: Justify;
              language.Description;
            }
          };
          HBox(60%) {
            HAlign: Center;
            language.ShowMap(3.5", 2");
          }
        };
      }
    }
  };

  ShowWordsForEachSegment = Block {
    foreach (var segment in SortedSegments) {
      Paragraph(null, [0.5"]) {
        KeepWithNext: true;
        TextHeight: 16pt;
        ParBackground: 90%;
        segment.ShowSegment;
       };

      Paragraph {
        PaperStyle.IPAFamily;
        SpaceAfter: 10pt;
        Span {
          Separator: Space*2;
          foreach (var cognate in Data.GetSortedCognates) {
            foreach (var word in cognate.Words) {
              if (word.Segments.FindElementIndex(segment) >= 0) {
                Span {
                  TipAction: word;
                  word.ShowPlain;
                }
              }
            }
          }
        };
      };
    }
  };
}

//======================================================================

abstract class ExperimentContent: Content {
  var ExperimentData Data;

  Constructor(ExperimentData data, title) {
    super.Constructor(title);
    Data = data;
  }
}

//======================================================================

class SegmentAssignmentsFigure: ExperimentContent {
  Constructor(ExperimentData data) {
    super.Constructor(data, "Segment Assignments");
  }

  override GetBody(ContentStyle style) = Block {
    Paragraph {
      var textheight = 18pt;
      TextHeight: textheight;

      foreach (var segment in Data.UniqueSegments) {
        HBox(textheight * 3.25, null, new Edge(0.25pt, 1, 85%)) {
          Margin: 5;
          Span {
            VAlignment: Top;
            TextColor: Colors.LightGray;
            TextHeight: 50%;
            each0;
          };
          HBox {
            HAlignment: Center;
            VAlignment: Center;
            segment.ShowSegment;
          }
        }
      }
    };
  };
}

